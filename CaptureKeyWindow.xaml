<Window x:Class="MacroForge.CaptureKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturar tecla"
        Width="340" Height="180"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI" FontSize="12">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Franja de color: azul para iniciar, rojo para detener -->
        <Border x:Name="AccentBar" Grid.Row="0" Background="#2563EB"/>

        <StackPanel Grid.Row="1" Margin="18,12,18,16" VerticalAlignment="Center">
            <TextBlock x:Name="StepText" Text=""
                       FontSize="10.5" Foreground="#9CA3AF"
                       HorizontalAlignment="Center"/>
                       
            <Viewbox StretchDirection="DownOnly" MaxWidth="300" HorizontalAlignment="Center">
                <TextBlock x:Name="ActionText" Text="TECLA"
                           FontSize="22" FontWeight="Bold" Foreground="#374151"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
            </Viewbox>

            <TextBlock x:Name="HintText" Text="Esc para cancelar"
                       FontSize="10.5" Foreground="#9CA3AF"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
